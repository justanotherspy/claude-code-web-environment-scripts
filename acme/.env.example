# Environment variables for the ACME simulation cloud environment
# (Environment variables field, `.env` format, one KEY=value per line).
# Read by acme/setup.sh and by the /etc/profile.d/zz-aws-acme.sh snippet it
# writes. Each session copies these once at startup, so edits reach new
# sessions only.

# Run acme/setup.sh under `set -x` to trace every command in the setup log.
SETUP_DEBUG=0

# Non-interactive CLI behaviour: sessions have no TTY.
GH_PROMPT_DISABLED=1
GH_NO_UPDATE_NOTIFIER=1
GH_SPINNER_DISABLED=1
DO_NOT_TRACK=1
# Keep the AWS CLI from opening a pager on every command.
AWS_PAGER=

# --- AWS (read-only) ---------------------------------------------------------
# At session start the profile.d snippet builds the `acme` AWS profile from
# these and makes it the default, so `aws` and `kubectl` run as a read-only
# role. The key belongs to the `claude-code-web` IAM user (acme-sim
# iac/bootstrap), whose only permission is sts:AssumeRole on ACME_AWS_ROLE_ARN.
# Unlike the rest of this file the key IS a secret: anyone using the
# environment can read it, so keep the user that narrow and rotate the key when
# the project ends. All three must be set, or the snippet does nothing.
#
# The names aren't AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY because sessions
# already set those to `proxy-injected` placeholders, and env keys outrank
# AWS_PROFILE. The snippet unsets the placeholders when these are present.
# ACME_AWS_ACCESS_KEY_ID=AKIA...
# ACME_AWS_SECRET_ACCESS_KEY=...
# ACME_AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/acme-claude-readonly
# ACME_AWS_REGION=eu-west-1

# --- Leave these unset ---------------------------------------------------------
# Same as default/.env.example: git identity, GH_TOKEN / GITHUB_TOKEN, PATH,
# proxy and CA variables, GOPATH / GOBIN, GOTOOLCHAIN.

# --- Version pins ----------------------------------------------------------------
# GO_VERSION overrides the toolchain pinned in acme/setup.sh. Leave it unset.
# GO_VERSION=1.27.2
