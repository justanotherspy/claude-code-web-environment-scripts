# Environment variables for the cloud environment's "Environment variables"
# field (cloud environment menu -> Edit). `.env` format: one KEY=value per line,
# no quotes. Every variable here is optional; leaving one unset keeps the
# default noted beside it.
#
# These are NOT secrets: anyone who can edit the environment can read them.
# Tokens go in the API credentials section instead (see credentials.example).
#
# The setup cache rebuilds when setup.sh or the network settings change, or
# after ~7 days, so a new pin may not reach sessions until one of those happens.

# Run default/setup.sh under `set -x` to trace every command in the setup log.
# 0 = off (default), 1 = on.
SETUP_DEBUG=0

# --- Version pins ------------------------------------------------------------
# Each tool tracks its latest release when the variable is unset. Uncomment a
# line to pin a release tag for a reproducible cache.

# sproot and shuck: read by their upstream install.sh.
# SPROOT_VERSION=v0.3.5
# SHUCK_VERSION=v0.3.5

# garlic and zizmor: read by install_garlic / install_zizmor in setup.sh.
# GARLIC_VERSION=v0.3.3
# ZIZMOR_VERSION=v1.25.2

# Go toolchain. setup.sh already pins GO_VERSION, and Renovate keeps that value
# current. Setting it here overrides the script and freezes Go at this version
# until you remove it, so leave it commented unless you need an older release.
# GO_VERSION=1.27.1
