# Environment variables for the cloud environment's "Environment variables"
# field (cloud environment menu -> Edit). `.env` format: one KEY=value per line,
# no quotes. Every variable here is optional; leaving one unset keeps the
# default noted beside it.
#
# These are NOT secrets: anyone who can edit the environment can read them.
# Tokens go in the API credentials section instead (see credentials.example).
#
# The setup cache rebuilds when setup.sh or the network settings change, or
# after ~7 days, so a new pin may not reach sessions until one of those happens.

# Run default/setup.sh under `set -x` to trace every command in the setup log.
# 0 = off (default), 1 = on.
SETUP_DEBUG=0

# --- Non-interactive CLI behaviour -------------------------------------------
# Sessions have no TTY and no one to answer prompts, so keep CLIs quiet and
# non-blocking.

# gh: fail instead of prompting, skip the "new release" notice and spinner.
GH_PROMPT_DISABLED=1
GH_NO_UPDATE_NOTIFIER=1
GH_SPINNER_DISABLED=1

# Opt out of usage telemetry. semgrep and cargo-binstall send it by default;
# DO_NOT_TRACK is the cross-tool convention other CLIs honour.
SEMGREP_SEND_METRICS=off
BINSTALL_DISABLE_TELEMETRY=true
DO_NOT_TRACK=1

# --- Go ----------------------------------------------------------------------
# Only needed if a Go repo imports a *private* justanotherspy module: it skips
# proxy.golang.org / sum.golang.org and fetches from GitHub over git. The
# session's git proxy authenticates that with the Claude GitHub App, so it
# works for any repo the session has access to.
# GOPRIVATE=github.com/justanotherspy/*

# --- Leave these unset -------------------------------------------------------
# The platform or the base image already sets them, and overriding them breaks
# things:
#   Git identity (GIT_AUTHOR_*, GIT_COMMITTER_*) and GIT_CONFIG_*: the platform
#     sets the commit identity and signs commits with its own key, and passes
#     git config through GIT_CONFIG_COUNT. A different author makes signed
#     commits show as unverified.
#   GH_TOKEN / GITHUB_TOKEN: the platform sets GH_TOKEN and the egress proxy
#     swaps in the Claude GitHub App's credentials. Your own token would replace
#     that and bypass the app's repo scoping.
#   PATH, HTTPS_PROXY / NO_PROXY and the *_CA_BUNDLE / SSL_CERT_FILE family:
#     they route traffic through the session's egress proxy.
#   GOPATH, GOBIN, CARGO_HOME, RUSTUP_HOME: setup.sh installs into the
#     defaults, so moving them hides the snapshot's tools.
#   GOTOOLCHAIN: the default (auto) fetches a newer Go when a go.mod asks for
#     one. `local` would make those builds fail instead.
#   RUST_BACKTRACE: already 1.

# --- Version pins ------------------------------------------------------------
# Each tool tracks its latest release when the variable is unset. Uncomment a
# line to pin a release tag for a reproducible cache.

# sproot and shuck: read by their upstream install.sh.
# SPROOT_VERSION=v0.3.5
# SHUCK_VERSION=v0.3.5

# garlic and zizmor: read by install_garlic / install_zizmor in setup.sh.
# GARLIC_VERSION=v0.3.3
# ZIZMOR_VERSION=v1.25.2

# Go toolchain. setup.sh already pins GO_VERSION, and Renovate keeps that value
# current. Setting it here overrides the script and freezes Go at this version
# until you remove it, so leave it commented unless you need an older release.
# GO_VERSION=1.27.1
