# Secrets for the cloud environment's API credentials section (cloud
# environment menu -> Edit -> API credentials). If your environment doesn't
# offer that section, use the Environment variables field instead, and keep in
# mind that anyone who can edit the environment can read those values.
#
# Every variable is optional. Add only the credentials for services you use,
# and give each token the narrowest scope that still works. Never commit real
# values to this repo.

# GitHub CLI (`gh`). Needed for private repos, and it raises the API rate limit
# for gh, gh extensions and any tool that reads GH_TOKEN. Use a fine-grained
# PAT limited to the repos you work on.
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fly.io CLI (`fly` / flyctl). Create one with `fly tokens create deploy` (one
# app) or `fly tokens create org` (all apps in an org).
FLY_API_TOKEN=FlyV1 fm2_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sprites CLI (`sprite`). API token from your sprites.dev account.
# Don't set SETUP_SPRITE_TOKEN: the sprite installer that setup.sh runs would
# write it into the cached filesystem snapshot.
SPRITES_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
